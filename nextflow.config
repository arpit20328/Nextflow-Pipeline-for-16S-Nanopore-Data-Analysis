manifesg {

        description = 'Nanopore 16S Pipeline' 

        author = 'Arpit Mathur, Vaibhav Gawde'

        nextflowVersion = '25.04.8'

}


params {

        input = "/home/arpit/arpit_data/nextflow_rifaximin_pipleine/samplesheet.csv"

        sequences = "/home/arpit/arpit_data/nextflow_rifaximin_pipleine/sequences/"

        generate_krona_tsv = "/home/arpit/arpit_data/nextflow_rifaximin_pipleine/scripts/arpit_made_krona_script.py"

        generate_krona_plot = "/home/arpit/Krona/KronaTools/scripts/ImportText.pl"

        index_calc = "/home/arpit/arpit_data/nextflow_rifaximin_pipleine/scripts/Index_calculation.sh"

	barplot_table_emu = "/home/arpit/arpit_data/nextflow_rifaximin_pipleine/scripts/barplot_emu_table.R"

	fmt_pdf = "/home/arpit/arpit_data/nextflow_rifaximin_pipleine/scripts/Patient_Report_Template_FMT.pdf"

	rif_pdf = "/home/arpit/arpit_data/nextflow_rifaximin_pipleine/scripts/Patient_Report_Template_Rifaximin.pdf"    

	wetlab_pdf = "/home/arpit/arpit_data/nextflow_rifaximin_pipleine/scripts/Wet_lab_Format.pdf"    

        coverage.sh = "/goast/arpit_data/nextflow_rifaximin_pipleine/scripts/coverage.sh"

      cut_off_page.sh = "/goast/arpit_data/nextflow_rifaximin_pipleine/scripts/cut_off_page.sh"
 
       cutoffs.txt =   "/goast/arpit_data/nextflow_rifaximin_pipleine/scripts/cutoffs.txt"

}


executor {

        cpus   = 190

}


trace {

        enabled = true

        file = './Final_Output/pipeline_trace.txt'

        fields = 'hash,task_id,name,status,exit,realtime,%cpu,rss'

}

process {
	resourceLimits = [ cpus: 190, memory: 400.GB, time: 30.d ]
}
